function renderTimelineRows(filteredUsers, fromDate, toDate) {
  const rowsContainer = document.getElementById('agentRowsContainer');
  const tracksContainer = document.getElementById('timelineTracksContainer');
  if(!rowsContainer || !tracksContainer) return;

  rowsContainer.innerHTML = '';
  tracksContainer.innerHTML = '';

  filteredUsers.forEach(u => {
    const rowLabel = document.createElement('div');
    rowLabel.className = 'agent-row-label';
    
    // Contact buttons formatting
    let contactHTML = '';
    if(u.phone) {
      contactHTML = `
        <div class="contact-group compact-contact">
          <a class="contact-btn btn-call" href="tel:${u.phone}" title="Call ${u.phone}">📞</a>
          <a class="contact-btn btn-wa" href="https://wa.me/${u.phone.replace(/[^0-9]/g,'')}" target="_blank" title="WhatsApp">💬</a>
          <a class="contact-btn btn-sms" href="sms:${u.phone}" title="SMS">✉️</a>
        </div>`;
    } else {
      contactHTML = `<span class="no-phone-tag">No Phone</span>`;
    }

    rowLabel.innerHTML = `
      <div class="agent-info">
        <div class="agent-name">${u.name}</div>
        <div class="agent-meta">${u.agency || 'HQ'} | ${u.queue || 'General'}</div>
      </div>
      ${contactHTML}
    `;
    rowsContainer.appendChild(rowLabel);

    const track = document.createElement('div');
    track.className = 'timeline-track-container';
    
    const overlay = document.createElement('div');
    overlay.className = 'timeline-grid-overlay';
    for(let i = 0; i < 24; i++) {
      const g = document.createElement('div');
      g.className = 'grid-hour';
      overlay.appendChild(g);
    }
    track.appendChild(overlay);

    // Retrieve blocks for date range
    let blocks = [];
    const key = `${u.id}_${fromDate}`;
    blocks = continuousSchedules[key] || [];

    blocks.forEach((b, idx) => {
      const blockEl = document.createElement('div');
      const foundAux = auxCodes.find(x => x.code === b.code) || { label: b.code, cls: 'unavailable' };
      blockEl.className = `aux-block ${foundAux.cls}`;
      
      const leftPx = (timeToMinutes(b.start) / 1440) * 1440;
      const widthPx = Math.max(15, ((timeToMinutes(b.end) - timeToMinutes(b.start)) / 1440) * 1440);
      
      blockEl.style.left = `${leftPx}px`;
      blockEl.style.width = `${widthPx}px`;
      blockEl.innerHTML = `<span>${foundAux.label} (${b.start}-${b.end})</span><span class="delete-btn" title="Delete block">&times;</span>`;
      
      blockEl.querySelector('.delete-btn').onclick = (e) => {
        e.stopPropagation();
        blocks.splice(idx, 1);
        continuousSchedules[key] = blocks;
        safeStorage.setItem("wfm_continuous_schedules", JSON.stringify(continuousSchedules));
        renderPlot();
      };

      blockEl.ondblclick = () => {
        openTimePlotModal(u.id, fromDate, b);
      };

      track.appendChild(blockEl);
    });

    track.ondragover = (e) => e.preventDefault();
    track.ondrop = (e) => {
      e.preventDefault();
      const code = e.dataTransfer.getData('text/plain');
      if(!code) return;
      const rect = track.getBoundingClientRect();
      const xClick = e.clientX - rect.left;
      const minutes = Math.floor((xClick / 1440) * 1440);
      const snapped = Math.round(minutes / 15) * 15;
      
      const startMin = Math.max(0, snapped);
      const endMin = Math.min(1440, startMin + 60);
      
      const newBlock = {
        code,
        start: minutesToTime(startMin),
        end: minutesToTime(endMin)
      };

      if(!continuousSchedules[key]) continuousSchedules[key] = [];
      continuousSchedules[key].push(newBlock);
      safeStorage.setItem("wfm_continuous_schedules", JSON.stringify(continuousSchedules));
      renderPlot();
    };

    tracksContainer.appendChild(track);
  });
}

function timeToMinutes(tStr) {
  const parts = tStr.split(':');
  return parseInt(parts[0]) * 60 + parseInt(parts[1]);
}

function minutesToTime(m) {
  const hh = Math.floor(m / 60) % 24;
  const mm = m % 60;
  return `${String(hh).padStart(2,'0')}:${String(mm).padStart(2,'0')}`;
}

