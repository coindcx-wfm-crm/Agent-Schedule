    id: 'u_' + Date.now(),
    name,
    username,
    password: "123",
    role: "Agent",
    agency: "Agency Alpha",
    queue: "Exchanges",
    phone: "+919876543200"
  });
  safeStorage.setItem("wfm_users", JSON.stringify(users));
  buildFilters();
  renderPlot();
}

function openResetModal() {
  document.getElementById('resetModal').classList.remove('hidden');
}

function closeResetModal() {
  document.getElementById('resetModal').classList.add('hidden');
  document.getElementById('otpStep1').classList.remove('hidden');
  document.getElementById('otpStep2').classList.add('hidden');
}

function sendOTP() {
  document.getElementById('otpStep1').classList.add('hidden');
  document.getElementById('otpStep2').classList.remove('hidden');
  alert("Simulated OTP sent to your email: 123456");
}

function verifyAndReset() {
  const otp = document.getElementById('otpInput').value;
  const newPass = document.getElementById('newPassInput').value;
  if(otp !== "123456" || !newPass) {
    document.getElementById('resetError').innerText = "Invalid OTP or password!";
    return;
  }
  const username = document.getElementById('resetUsername').value.trim();
  const found = users.find(x => x.username.toLowerCase() === username.toLowerCase());
  if(found) {
    found.password = newPass;
    safeStorage.setItem("wfm_users", JSON.stringify(users));
    alert("Password reset successfully! Please sign in.");
    closeResetModal();
  } else {
    document.getElementById('resetError').innerText = "Username not found!";
  }
}
</script>
