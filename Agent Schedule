  { code: 'PLANNEDLEAVE', label: 'Planned Leave', cls: 'plannedleave', category: 'leave' },
  { code: 'SICKLEAVE', label: 'Sick Leave', cls: 'sickleave', category: 'leave' },
  { code: 'NCNS', label: 'NCNS', cls: 'ncns', category: 'leave' },
  { code: 'UNPAIDLEAVE', label: 'Unpaid Leave', cls: 'unpaidleave', category: 'leave' },
  { code: 'CASUALLEAVE', label: 'Casual Leave', cls: 'casualleave', category: 'leave' },
  { code: 'HOLIDAY', label: 'Holiday', cls: 'holiday', category: 'leave' },
  { code: 'COMPOFF', label: 'Comp Off', cls: 'compoff', category: 'leave' },
  { code: 'UNPLANNEDLEAVE', label: 'Unplanned Leave', cls: 'unplannedleave', category: 'leave' }
];

const safeStorage = {
  getItem: (k) => localStorage.getItem(k),
  setItem: (k, v) => { localStorage.setItem(k, v); if(typeof window.saveAll === 'function') window.saveAll(); }
};

function __safeParse(val, fallback) {
  try { const parsed = JSON.parse(val); return parsed !== null ? parsed : fallback; } catch(e) { return fallback; }
}

let users = __safeParse(safeStorage.getItem("wfm_users"), [
  { id: "u1", name: "Admin Manager", username: "admin", password: "123", role: "Admin", agency: "CoinDCX HQ", queue: "Core Support", phone: "+919876543210" },
  { id: "u2", name: "Operations Lead", username: "manager", password: "123", role: "Manager", agency: "CoinDCX HQ", queue: "VIP Tier", phone: "+919876543211" },
  { id: "u3", name: "Aarav Sharma", username: "agent001", password: "123", role: "Agent", agency: "Agency Alpha", queue: "Exchanges", phone: "+919876543212" },
  { id: "u4", name: "Priya Patel", username: "agent002", password: "123", role: "Agent", agency: "Agency Beta", queue: "Wallet", phone: "+919876543213" }
]);

let continuousSchedules = __safeParse(safeStorage.getItem("wfm_continuous_schedules"), {});
let grid15mSchedules = __safeParse(safeStorage.getItem("wfm_grid15m_schedules"), {});
let auxLogs = __safeParse(safeStorage.getItem("wfm_aux_logs"), {});
let inactivityLogs = __safeParse(safeStorage.getItem("wfm_inactivity_logs"), {});
let locationLogs = __safeParse(safeStorage.getItem("wfm_location_logs"), {});
let callingLeads = __safeParse(safeStorage.getItem("wfm_calling_leads"), [
  { id: "l1", customerName: "Vikram Malhotra", phone: "+919123456789", queue: "Exchanges", assignee: "agent001", status: "Pending" },
  { id: "l2", customerName: "Neha Gupta", phone: "+919234567890", queue: "Wallet", assignee: "agent002", status: "In Progress" }
]);

let currentUser = null;
let currentPlotMode = 'timeline';
let activeModalAgentId = null;
let activeModalDate = null;
let liveTimerInterval = null;
let liveClockInterval = null;

function getTodayStr() {
  const d = new Date();
  return d.toISOString().split('T')[0];
}

window.onload = function() {
  const today = getTodayStr();
  if(document.getElementById('scheduleFromDate')) document.getElementById('scheduleFromDate').value = today;
  if(document.getElementById('scheduleToDate')) document.getElementById('scheduleToDate').value = today;
  if(document.getElementById('scheduleDate')) document.getElementById('scheduleDate').value = today;
  if(document.getElementById('historyDate')) document.getElementById('historyDate').value = today;
  if(document.getElementById('reportDate')) document.getElementById('reportDate').value = today;
  if(document.getElementById('attendanceFromDate')) document.getElementById('attendanceFromDate').value = today;
  if(document.getElementById('attendanceToDate')) document.getElementById('attendanceToDate').value = today;

  startLiveClock();
  populateLegend();
  populateModalAuxSelect();

  const savedUname = safeStorage.getItem("wfm_current_user_id");
  if(savedUname) {
    const found = users.find(x => x.username.toLowerCase() === savedUname.toLowerCase() || x.id === savedUname);
    if(found) {
      currentUser = found;
      initializeAppView();
      return;
    }
  }
  document.getElementById('loginScreen').classList.remove('hidden');
};

function startLiveClock() {
  if(liveClockInterval) clearInterval(liveClockInterval);
  updateClockAndHeader();
  liveClockInterval = setInterval(updateClockAndHeader, 1000);
}

function updateClockAndHeader() {
  const now = new Date();
  const timeStr = now.toLocaleTimeString();
  const dateStr = now.toDateString();
  if(document.getElementById('liveClock')) document.getElementById('liveClock').innerText = timeStr;
  if(document.getElementById('liveHeaderDate')) document.getElementById('liveHeaderDate').innerText = dateStr;

  if(currentUser) {
    const liveStatusMap = __safeParse(safeStorage.getItem("wfm_live_agent_status"), {});
    const st = liveStatusMap[currentUser.id];
    if(st && st.startTime) {
      const diff = Math.floor((now.getTime() - st.startTime) / 1000);
      const h = String(Math.floor(diff / 3600)).padStart(2,'0');
      const m = String(Math.floor((diff % 3600) / 60)).padStart(2,'0');
      const s = String(diff % 60).padStart(2,'0');
      if(document.getElementById('pillTimer')) document.getElementById('pillTimer').innerText = `${h}:${m}:${s}`;
      if(document.getElementById('currentTimer')) document.getElementById('currentTimer').innerText = `${h}:${m}:${s}`;
    }
  }
}

function login() {
  const uInput = document.getElementById('loginUser').value.trim();
  const pInput = document.getElementById('loginPass').value.trim();
  const err = document.getElementById('loginError');

  const found = users.find(x => x.username.toLowerCase() === uInput.toLowerCase() || (x.email && x.email.toLowerCase() === uInput.toLowerCase()));
  if(!found || found.password !== pInput) {
    err.innerText = "Invalid username/email or password!";
    return;
  }
  err.innerText = "";
  currentUser = found;
  safeStorage.setItem("wfm_current_user_id", currentUser.username);
  initializeAppView();
}

function logout() {
  currentUser = null;
  safeStorage.removeItem("wfm_current_user_id");
  document.getElementById('app').classList.add('hidden');
  document.getElementById('loginScreen').classList.remove('hidden');
}

function initializeAppView() {
  document.getElementById('loginScreen').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');

  const role = currentUser.role;
  document.getElementById('topUser').innerText = currentUser.name;
  document.getElementById('roleBadge').innerText = role;
  document.getElementById('centerUserNameRole').innerText = `${currentUser.name} (${role})`;

  const isMgr = (role === 'Admin' || role === 'Manager');
  const isAdmin = (role === 'Admin');

  document.querySelectorAll('.managerOnly').forEach(el => {
    if(!isMgr) el.classList.add('hidden'); else el.classList.remove('hidden');
  });
  document.querySelectorAll('.adminOnly').forEach(el => {
    if(!isAdmin) el.classList.add('hidden'); else el.classList.remove('hidden');
  });

  buildFilters();
  setupAuxDropdownOptions();

  // Initialize live AUX if missing
  const liveStatusMap = __safeParse(safeStorage.getItem("wfm_live_agent_status"), {});
  if(!liveStatusMap[currentUser.id]) {
    liveStatusMap[currentUser.id] = { code: 'UNAVAILABLE', startTime: new Date().getTime() };
    safeStorage.setItem("wfm_live_agent_status", JSON.stringify(liveStatusMap));
  }
  syncLiveAuxTopPill(liveStatusMap);

  if(isMgr) {
    showTab('plot');
  } else {
    showTab('agent');
  }
}

function showTab(tabName) {
  ['plot', 'agent', 'leads', 'dashboard', 'attendance', 'admin', 'settings'].forEach(t => {
    const sec = document.getElementById(t + 'Section');
    const btn = document.getElementById(t + 'Tab');
    if(sec) sec.classList.add('hidden');
    if(btn) btn.classList.remove('active');
  });

  const targetSec = document.getElementById(tabName + 'Section');
  const targetBtn = document.getElementById(tabName + 'Tab');
  if(targetSec) targetSec.classList.remove('hidden');
  if(targetBtn) targetBtn.classList.add('active');

  if(tabName === 'plot') renderPlot();
  if(tabName === 'agent') renderAgentHistory();
  if(tabName === 'leads') renderLeads();
  if(tabName === 'dashboard') renderDashboard();
  if(tabName === 'attendance') renderAttendance();
  if(tabName === 'admin') renderAdmin();
}

function populateLegend() {
  const leg = document.getElementById('legend');
  if(!leg) return;
  leg.innerHTML = '';
  auxCodes.forEach(ac => {
    const span = document.createElement('span');
    span.className = ac.cls;
    span.innerText = ac.label;
    span.draggable = true;
    span.ondragstart = (e) => {
      e.dataTransfer.setData('text/plain', ac.code);
    };
    leg.appendChild(span);
  });
}

function populateModalAuxSelect() {
  const sel = document.getElementById('modalAuxSelect');
  if(!sel) return;
  sel.innerHTML = '';
  auxCodes.forEach(ac => {
    const opt = document.createElement('option');
    opt.value = ac.code;
    opt.innerText = ac.label;
    sel.appendChild(opt);
  });
}

function buildFilters() {
  const agSelect = document.getElementById('agencyFilter');
  const qSelect = document.getElementById('queueFilter');
  if(!agSelect || !qSelect) return;

  const agencies = [...new Set(users.map(u => u.agency || 'Unassigned'))];
  const queues = [...new Set(users.map(u => u.queue || 'Unassigned'))];

  agSelect.innerHTML = '<option value="">All Agencies</option>';
  agencies.forEach(a => {
    const opt = document.createElement('option');
    opt.value = a;
    opt.innerText = a;
    agSelect.appendChild(opt);
  });

  qSelect.innerHTML = '<option value="">All Queues</option>';
  queues.forEach(q => {
    const opt = document.createElement('option');
    opt.value = q;
    opt.innerText = q;
    qSelect.appendChild(opt);
  });

  const dashAg = document.getElementById('dashAgencyFilter');
  const dashQ = document.getElementById('dashQueueFilter');
  if(dashAg && dashQ) {
    dashAg.innerHTML = '';
    agencies.forEach(a => {
      const opt = document.createElement('option');
      opt.value = a;
      opt.innerText = a;
      opt.selected = true;
      dashAg.appendChild(opt);
    });
    dashQ.innerHTML = '';
