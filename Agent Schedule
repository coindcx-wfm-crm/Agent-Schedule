function handleExcelImport(e) {
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(evt) {
    const data = new Uint8Array(evt.target.result);
    const workbook = XLSX.read(data, { type: 'array' });
    const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
    const rows = XLSX.utils.sheet_to_json(firstSheet);

    rows.forEach(r => {
      const uname = String(r.Username || r.AgentID || '').trim();
      const dateStr = String(r.Date || '').trim();
      const code = String(r.AUXCode || '').trim().toUpperCase();
      const start = String(r.StartTime || '').trim();
      const end = String(r.EndTime || '').trim();

      const found = users.find(x => x.username.toLowerCase() === uname.toLowerCase() || x.id === uname);
      if(found && dateStr && code && start && end) {
        const key = `${found.id}_${dateStr}`;
        if(!continuousSchedules[key]) continuousSchedules[key] = [];
        continuousSchedules[key].push({ code, start, end });
      }
    });

    safeStorage.setItem("wfm_continuous_schedules", JSON.stringify(continuousSchedules));
    renderPlot();
    alert("Excel schedule data successfully imported and merged!");
  };
  reader.readAsArrayBuffer(file);
}

